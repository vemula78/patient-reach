   "fieldtype": "Data",
   "label": "Rule set",
   "hidden": 1,
   "read_only": 1,
   "description": "Which rules this visit is graded by, stamped when it is created and never changed. DRL v1.4: red flags, BP tiers, referral, events and the Level 4 lock (Dr Nayanjeet Chaudhury, 13-Oct-2026). 2026-10-07: his BP rule of 07-Oct. Blank: the rule before 05-Oct-2026 (High from 140/90). 2026-10 (06-Oct) is no longer used.",
   "default": "DRL v1.4"
  },
  {
   "fieldname": "health_events_section",
   "fieldtype": "Section Break",
   "label": "Heart and brain events (DRL A8)",
   "depends_on": "eval:doc.bp_rule=='DRL v1.4'"
  },
  {
   "fieldname": "health_events_note",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted small\">Record each heart attack, stroke, TIA, angioplasty or stent, or bypass the caregiver has had, and how it is known. A qualifying event makes the caregiver Level 4 for good. If the caregiver mentions paralysis, choose \"Paralysis or weakness, not yet clarified\" and ask what happened: it is not recorded as a stroke until that is known.</p>"
  },
  {
   "fieldname": "health_events",
   "fieldtype": "Table",
   "label": "Events",
   "options": "Sparsh Health Event"
  },
  {
   "fieldname": "level",
   "fieldtype": "Select",
   "label": "Prevention Level",
   "options": "\nLevel 1\nLevel 2\nLevel 3\nLevel 4",
   "depends_on": "eval:doc.bp_rule=='DRL v1.4'",
   "mandatory_depends_on": "eval:doc.bp_rule=='DRL v1.4' && doc.ticket_type == 'Preventive Cardiology' && doc.visit_type == 'First Visit'",
   "description": "Level 1 Primordial, 2 Primary (at risk), 3 Secondary (has the disease), 4 Tertiary (survivor of a heart attack, stroke or other DRL A8 event). The S modifier is recorded separately below, and neither it nor the BP changes the Level."
  },
  {
