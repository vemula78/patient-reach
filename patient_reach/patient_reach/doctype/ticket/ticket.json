  {
   "fieldname": "emergency_action",
   "fieldtype": "Select",
   "label": "Emergency action taken",
   "depends_on": "eval:doc.red_flag_status=='Red-flag symptom present'",
   "options": "\nCalled 112 or an ambulance\nSent to the nearest Emergency Department\nUsed the hospital's emergency process\nCaregiver declined emergency care"
  },
  {
   "fieldname": "emergency_note",
   "fieldtype": "HTML",
   "depends_on": "eval:doc.red_flag_status=='Red-flag symptom present'",
   "options": "<p style=\"color: var(--red-600); font-weight: var(--weight-semibold); margin-bottom: 0;\">EMERGENCY: call 112, or take the caregiver to the nearest Emergency Department, or use the hospital's emergency process, now. Stop routine counselling. Do not wait for a repeat BP, a doctor's review or the clinical reviewer.</p>"
  },
  {
   "fieldname": "bp_technique_note",
   "fieldtype": "HTML",
   "depends_on": "eval:doc.bp_rule=='DRL v1.4'",
   "options": "<p class=\"text-muted small\">Rest quietly for 5 minutes before the first reading. Use the right cuff size, with the back and arm supported and no talking. Repeat after 1-2 minutes on the same arm, and record both readings. Never delay an emergency to repeat the BP.</p>"
  },
  {
   "fieldname": "bp_alerts",
   "fieldtype": "Small Text",
   "label": "BP Alerts",
   "read_only": 1,
   "depends_on": "eval:doc.bp_alerts",
   "description": "Every abnormal finding from the two readings. A lower repeat does not remove one."
  },
  {
   "fieldname": "low_bp_symptoms",
   "fieldtype": "Select",
   "label": "Low BP symptoms: dizziness or light-headedness, fainting or near-fainting, unusual weakness, confusion",
   "options": "\nYes\nNo",
   "depends_on": "eval:doc.bp_rule=='DRL v1.4' && (doc.bp_alerts || '').includes('Low')"
  },
  {
   "fieldname": "drl_bp_note",
   "fieldtype": "HTML",
   "depends_on": "eval:doc.bp_rule=='DRL v1.4' && doc.bp_status",
   "options": "<p class=\"text-muted small\">BP Status is a screening flag from one or two readings, not a diagnosis. Volunteers do not diagnose hypertension or stroke, and do not start or change medication.</p>"
  },
  {
   "fieldname": "referral_section",
   "fieldtype": "Section Break",
   "label": "Physician referral",
   "depends_on": "eval:doc.bp_rule=='DRL v1.4'"
  },
  {
   "fieldname": "referral_priority",
   "fieldtype": "Select",
   "label": "Referral Priority",
   "options": "\nEmergency\nImmediate clinical assessment\nPhysician within 24-48 hours\nClinical review (low BP)\nPhysician within 4 weeks\nRepeat BP needed\nNo referral needed",
   "read_only": 1,
   "description": "Worked out from the red flags, the BP readings and the events. Blank: not enough recorded to tell."
  },
  {
   "fieldname": "referral_advised",
   "fieldtype": "Select",
   "label": "Referral advised to the caregiver?",
