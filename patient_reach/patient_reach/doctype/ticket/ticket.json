  {
   "fieldname": "best_time_to_call",
   "fieldtype": "Data",
   "label": "Best time to call",
   "mandatory_depends_on": "eval:doc.ticket_type == 'Preventive Cardiology' && doc.visit_type == 'First Visit'"
  },
  {
   "description": "<ul><li>Level 1 (Primordial): Healthy, No bad habits, No Cardiometabolic diagnosis, No family history.</li><li>Level 1s: \"S\" modifier (Past surgeries and Structural illness) for Level 1.</li><li>Level 2 (Primary): \"At Risk.\" Has habits (Smoking/Stress/Pre-diabetic/family history) but no disease yet.</li><li>Level 2s: \"S\" modifier (Past surgeries and Structural illness) for Level 2.</li><li>Level 3 (Secondary): \"Sick.\" Has BP/Diabetes/Obesity/Heart Disease/Kidney/Thyroid/Liver disease.</li><li>Level 3s: \"S\" modifier (Past surgeries and Structural illness) for Level 3.</li><li>Level 4 (Tertiary): \"Survivor.\" Already had a heart attack/stroke.</li><li>Level 4s: \"S\" modifier (Past surgeries and Structural illness) for Level 4.</li></ul>",
   "fieldname": "prevention_level",
   "fieldtype": "Select",
   "label": "Where does the Caregiver fit in the Levels of Prevention ?",
   "mandatory_depends_on": "eval:doc.bp_rule!='DRL v1.4' && doc.ticket_type == 'Preventive Cardiology' && doc.visit_type == 'First Visit'",
   "options": "\nLevel 1\nLevel 1s\nLevel 2\nLevel 2s\nLevel 3\nLevel 3s\nLevel 4\nLevel 4s",
   "depends_on": "eval:doc.bp_rule!='DRL v1.4'"
  },
  {
   "fieldname": "risk_level_col",
   "fieldtype": "Column Break"
  },
  {
