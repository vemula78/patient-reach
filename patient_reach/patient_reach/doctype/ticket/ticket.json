   "label": "Waist Measurement (in cm)"
  },
  {
   "fieldname": "height_cm",
   "fieldtype": "Float",
   "label": "Height (in cm)"
  },
  {
   "fieldname": "string_test_result",
   "fieldtype": "Select",
   "label": "The String Test Result (Visceral Fat)",
   "options": "\nPASS (Ends touch/ W:H < 0.5)\nFAIL (Gap exists - Central Obesity)",
   "read_only": 1,
   "description": "Calculated from waist and height: PASS when the waist is less than half the height (waist ÷ height &lt; 0.5)."
  },
  {
   "fieldname": "bp_heading",
   "fieldtype": "Section Break",
   "label": "2. Blood Pressure (BP)"
  },
  {
   "fieldname": "rested_5_min",
   "fieldtype": "Select",
   "label": "Did the Caregiver rest for 5 mins in silence before BP ?",
   "options": "\nYes\nNo"
  },
  {
   "description": "Example: 120/80",
   "fieldname": "bp_reading",
   "fieldtype": "Data",
   "label": "Blood Pressure Reading (mmHg)"
  },
  {
   "description": "Calculated from the readings. DRL v1.4 (visits from its release): Severe 180/120 or above; High Priority 160/100 or above; High 140/90 or above; Elevated 120/80 or above; Normal below 120/80; Low below 90/60, shown beside any high tier under BP Alerts. The higher of the two readings counts. Earlier visits keep the rule they were graded by (Dr Nayanjeet Chaudhury's rule of 07-Oct-2026: Urgent 180/120 or more, Low below 90/60, High 140/90 or more, Elevated 120/80 or more). Needs Reference: a reading that cannot be read.",
   "fieldname": "bp_status",
   "fieldtype": "Select",
   "label": "BP Status",
   "options": "\nNormal\nElevated\nHigh\nHigh Priority\nSevere\nLow\nUrgent\nNeeds Reference",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.bp_status=='Other'",
   "fieldname": "bp_status_other",
   "fieldtype": "Data",
   "label": "If Other, specify"
  },
  {
   "fieldname": "bp_repeat_reading",
   "fieldtype": "Data",
   "label": "Repeat BP Reading (mmHg)",
   "depends_on": "eval:doc.bp_rule=='DRL v1.4' ? (['Severe','High Priority','High','Low'].includes(doc.bp_status) || doc.bp_repeat_reading) : (doc.bp_action && (['Urgent','Low','High'].includes(doc.bp_status) || doc.bp_repeat_reading))",
   "description": "After 1-2 minutes, on the same arm. Earlier visits: after the caregiver has rested; for an Urgent first reading, after 5 minutes."
  },
  {
   "fieldname": "bp_concerning_symptoms",
   "fieldtype": "Check",
   "depends_on": "eval:doc.bp_rule!='DRL v1.4' && (doc.bp_action && (['Urgent','Low','High'].includes(doc.bp_status) || doc.bp_repeat_reading))",
   "label": "Concerning symptoms: dizziness/light-headedness, fainting/near-fainting, unusual weakness, confusion or other"
  },
  {
   "fieldname": "bp_action",
   "fieldtype": "Small Text",
   "label": "BP Action",
   "read_only": 1,
   "depends_on": "eval:doc.bp_action"
  },
  {
   "fieldname": "bp_escalation_note",
   "fieldtype": "HTML",
   "depends_on": "eval:doc.bp_rule!='DRL v1.4' && ([\"Immediate clinical escalation\", \"Urgent clinical review\", \"Clinical escalation\"].includes(doc.bp_action) && !doc.forward_to)",
   "options": "<p style=\"color: var(--red-600); font-weight: var(--weight-semibold); margin-bottom: 0;\">Needs clinical review: forward this visit to a doctor under Clinical Review &gt; Forward To.</p>"
  },
  {
   "fieldname": "bp_note",
   "fieldtype": "HTML",
   "depends_on": "eval:doc.bp_rule!='DRL v1.4' && (doc.bp_action)",
   "options": "<p class=\"text-muted small\">This BP Status is a screening flag from a single reading, not a diagnosis of hypertension. If the reading is high, repeat it after the caregiver has rested. At 180/120 or above, or with concerning symptoms, follow the safety and escalation pathway: forward the visit to a doctor under Clinical Review.</p>"
  },
